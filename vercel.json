{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/apkyuklash",
      "destination": "/apk.html"
    },
    {
      "source": "/apk",
      "destination": "/apk.html"
    },
    {
      "source": "/iphone",
      "destination": "/iphone.html"
    },
    {
      "source": "/ios",
      "destination": "/iphone.html"
    },
    {
      "source": "/maxfiylik",
      "destination": "/maxfiylik.html"
    },
    {
      "source": "/privacy",
      "destination": "/maxfiylik.html"
    }
  ],
  "headers": [
    {
      "source": "/download/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Bilols-AI.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
